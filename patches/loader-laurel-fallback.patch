+/*
+ * A clean EfiResetCold makes ABL retry the same slot; a watchdog bite is a
+ * failed boot, so ABL decrements the slot retry count and falls back to the
+ * other slot. The hypervisor watchdog is armed by wdt_arm() on laurel.
+ */
+static void
+fallback_watchdog(void)
+{
+	if (wdt_armed) {
+		wdt_set_ms(2000);
+		for (;;) {
+			__asm__ volatile ("wfi");
+		}
+	}
+	ST->rt->reset_system(0 /* EfiResetCold */, 0, 0, NULL);
+	for (;;) {
+	}
+}
