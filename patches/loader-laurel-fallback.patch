+/*
+ * laurel reserves a ramoops region (768 KiB at 0xffc40000: 96 x 4 KiB dmesg
+ * records, then 256 KiB console and 128 KiB pmsg, ecc 0) and the Linux kernel
+ * registers pstore on it at boot. Leave the log there before a reset: pstore
+ * exposes each record as /sys/fs/pstore/dmesg-ramoops-N, so the XNU log is
+ * readable from Linux without UFS BlockIo or /dev/mem.
+ */
+#define RAMOOPS_PA      0xF3000000ULL
+#define RAMOOPS_RECORD  4096
+#define RAMOOPS_ZONES   96
+#define RAMOOPS_SIG     0x43474244u
+static int ram_log_has_kernel;          /* this run's kernel log was kept: a later flush must not replace it */
+static void persist_log_ram(const char *data, uint64_t len);
+
