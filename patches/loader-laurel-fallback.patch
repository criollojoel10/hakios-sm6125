diff --git a/xnuloader/loader.c b/xnuloader/loader.c
index 422f9d3..8165427 100644
--- a/xnuloader/loader.c
+++ b/xnuloader/loader.c
@@ -588,16 +588,24 @@ static const struct platform platform_redwood = {
 	.small_cores = 0x0f,
 };
 
+static const struct platform platform_laurel = {
+	/* laurel_sprout: same SM6125 facts as ginkgo; SMC PSCI, GIC 0x0f200000/0x0f300000 */
+	.name = "laurel", .io_base = 0x00400000, .io_size = 0x3FC00000,
+	.gic_dist = 0x0F200000, .gic_redist = 0x0F300000, .uart = 0,
+	.psci_hvc = 0, .log_other_cpu = 1,
+	.cores = 8, .core_shift = 8, .small_cores = 0x0f,
+};
+
 /* ------------------------------------------------------------------------ */
 
+static void fallback_watchdog(void);
+
 static void
 reboot(void)
 {
 	hc_take_back("before the reset");
 	flush_log();
-	ST->rt->reset_system(0 /* EfiResetCold */, 0, 0, NULL);
-	for (;;) {
-	}
+	fallback_watchdog();
 }
 
 /*
@@ -2503,7 +2511,7 @@ wdt_arm(void)
 {
 	uint64_t ctl = 0, since = 0;
 
-	if (PLAT != &platform_redwood) {
+	if (PLAT == &platform_qemu_virt) {
 		return; /* SMC is not routed anywhere useful on QEMU virt */
 	}
 	uint64_t st = smc_call(VIRT_WDT_STATUS, 0, 0, &ctl, &since);
@@ -2515,6 +2523,25 @@ wdt_arm(void)
 	wdt_armed = (r_pet == 0);
 }
 
+/*
+ * A clean EfiResetCold makes ABL retry the same slot; a watchdog bite is a
+ * failed boot, so ABL decrements the slot retry count and falls back to the
+ * other slot. The hypervisor watchdog is armed by wdt_arm() on laurel.
+ */
+static void
+fallback_watchdog(void)
+{
+	if (wdt_armed) {
+		wdt_set_ms(2000);
+		for (;;) {
+			__asm__ volatile ("wfi");
+		}
+	}
+	ST->rt->reset_system(0 /* EfiResetCold */, 0, 0, NULL);
+	for (;;) {
+	}
+}
+
 /* ------------------------------------------------------------------------ */
 /* UEFI exception hook: put the fault into the log instead of on the screen  */
 
@@ -2528,9 +2555,7 @@ exception_handler(int64_t type, uint64_t *ctx)
 	print("loader image base %x (elr offset %x)\n", (uint64_t)(uintptr_t)&__ImageBase,
 	    ctx[EXC_CTX_ELR] - (uint64_t)(uintptr_t)&__ImageBase);
 	flush_log();
-	ST->rt->reset_system(0 /* EfiResetCold */, 0, 0, NULL);
-	for (;;) {
-	}
+	fallback_watchdog();
 }
 
 static void
@@ -4350,6 +4375,12 @@ efi_main(efi_handle image, efi_system_table *st)
 		}
 		print("display %d x %d at %x\n", (uint64_t)SCREEN.width, (uint64_t)SCREEN.height, SCREEN.base);
 	}
+	{
+		uint32_t part = (uint32_t)((READ_SYSREG(MIDR_EL1) >> 4) & 0xfff);
+		if (part == 0xd03 || part == 0xd09) {
+			PLAT = &platform_laurel;
+		}
+	}
 	print("platform %s\n", PLAT->name);
 
 	install_exception_hook();
