+/* The pstore/ramoops handoff: laurel only, where the region and its 4 KiB records are known. */
+static void
+persist_log_ram(const char *data, uint64_t len)
+{
+	static const char hdr[] = "====0.000000-D\n";   /* pstore dmesg record header, uncompressed */
+	uint8_t *base = (uint8_t *)(uintptr_t)RAMOOPS_PA;
+	uint64_t off = 0;
+	int zone = 0;
+
+	if (PLAT != &platform_laurel || data == NULL || len == 0) {
+		return;
+	}
+	memset(base, 0, (uint64_t)RAMOOPS_ZONES * RAMOOPS_RECORD);
+	while (off < len && zone < RAMOOPS_ZONES) {
+		uint64_t cap = RAMOOPS_RECORD - 12 - (sizeof(hdr) - 1);
+		uint64_t take = len - off;
+		uint8_t *z = base + (uint64_t)zone * RAMOOPS_RECORD;
+
+		if (take > cap) {
+			take = cap;
+		}
+		*(uint32_t *)(z + 0) = RAMOOPS_SIG;
+		*(uint32_t *)(z + 4) = 0;               /* start */
+		memcpy(z + 12, hdr, sizeof(hdr) - 1);
+		memcpy(z + 12 + (sizeof(hdr) - 1), data + off, take);
+		*(uint32_t *)(z + 8) = (uint32_t)((sizeof(hdr) - 1) + take);        /* data bytes, not the 12-byte header */
+		off += take;
+		zone++;
+	}
+	clean_dcache((uint64_t)(uintptr_t)base, (uint64_t)(uintptr_t)base + (uint64_t)zone * RAMOOPS_RECORD);
+}
