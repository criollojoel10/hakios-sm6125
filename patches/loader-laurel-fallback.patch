+/*
+ * SM6125 (ginkgo and laurel): four Cortex-A53 cores numbered 0x0-0x3 and four
+ * Cortex-A73 cores numbered 0x100-0x103. No single shift turns the kernel's
+ * 0-7 core index into both ranges, so the platform carries the MPIDRs.
+ */
+static const uint32_t sm6125_core_mpidr[8] = {
+	0x000, 0x001, 0x002, 0x003, 0x100, 0x101, 0x102, 0x103,
+};
+
+static const struct platform platform_laurel = {
+	/* laurel_sprout: same SM6125 facts as ginkgo; SMC PSCI, GIC 0x0f200000/0x0f300000 */
+	.name = "laurel", .io_base = 0x00400000, .io_size = 0x3FC00000,
+	.gic_dist = 0x0F200000, .gic_redist = 0x0F300000, .uart = 0,
+	.psci_hvc = 0, .log_other_cpu = 1,
+	.cores = 8, .core_shift = 8, .core_mpidr = sm6125_core_mpidr, .small_cores = 0x0f,
+};
+
+/* the MPIDR of core N: the platform's table when it has one, else N shifted into Affinity1 */
+static uint64_t
+plat_core_mpidr(const struct platform *plat, int core)
+{
+	if (core < 0 || core >= plat->cores) {
+		return UINT64_MAX;
+	}
+	if (plat->core_mpidr != NULL) {
+		return plat->core_mpidr[core];
+	}
+	return (uint64_t)core << plat->core_shift;
+}
+
+/* the number of that MPIDR in the platform's 0..cores-1 numbering, -1 if it is not one of its cores */
+static int
+plat_mpidr_core(const struct platform *plat, uint64_t mpidr)
+{
+	if (plat->core_mpidr != NULL) {
+		for (int core = 0; core < plat->cores; core++) {
+			if (plat->core_mpidr[core] == (uint32_t)mpidr) {
+				return core;
+			}
+		}
+		return -1;
+	}
+	return (int)(mpidr >> plat->core_shift);
+}
