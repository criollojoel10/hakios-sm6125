# HakiOS fragment: the Qualcomm SM6125 ("trinket", Snapdragon 665) -- what is true of the SoC, whatever
# phone it is in.
#
# Differences from the SC7280 reference that matter for the port:
#   - SM6125 uses the older RPM (not RPMh): no rsc/RPMh controller, the clock and regulator providers
#     come from rpmcc/rpmpd. tools/soc-args.py's soc_rsc output does not apply here.
#   - The IPAs and the mailbox layout are read from the phone's own device tree (pull-soc.sh).
#   - The GPU is an Adreno 610 and mainline sm6125.dtsi has no gpu node yet, so gpu=1 has nothing to bind
#     to until a node and the zap shader path exist (gpucc-sm6125 is upstream; the node is not).
CONFIG_SOC="sm6125"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_SOCINFO=y
CONFIG_THERMAL=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
# no CONFIG_CPUFREQ / CONFIG_HAKIOS_CPUFREQ until the rpmhpd/rpmcc path for this SoC is written
